#!/usr/bin/expect -f
# Drive an Alpine guest over its serial console: log in as root, mount the
# host share, run one script from it, power off.
#
#   alpine-console.exp <script-in-share> <vmctl command line...>

if {$argc < 2} {
	puts stderr "usage: alpine-console.exp <script> <command...>"
	exit 2
}
set script [lindex $argv 0]
set cmd [lrange $argv 1 end]

proc fail {msg} {
	puts stderr "\n*** $msg"
	catch {exec kill [exp_pid]}
	exit 1
}

set timeout 300
spawn {*}$cmd
expect {
	"login:" {}
	timeout { fail "no login prompt on the serial console" }
	eof { fail "VM exited before reaching a login prompt" }
}
send "root\r"
# No end anchor: busybox ash follows its prompt with a cursor query (ESC \[6n).
set timeout 60
expect {
	-re {:~# } {}
	timeout { fail "no root shell prompt" }
	eof { fail "VM exited at login" }
}

send "modprobe virtiofs; mkdir -p /mnt/setup && mount -t virtiofs shared /mnt/setup && sh /mnt/setup/$script; echo SCRIPT_EXIT=\$?\r"
set timeout 3600
set rc 1
expect {
	-re {SCRIPT_EXIT=(\d+)} { set rc $expect_out(1,string) }
	timeout { fail "$script did not finish within an hour" }
	eof { fail "VM exited while running $script" }
}

send "sync; poweroff\r"
set timeout 120
expect {
	eof {}
	timeout { fail "guest did not power off" }
}
exit $rc
